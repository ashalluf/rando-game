extends SceneTree
## Measures how fast each crowd rig's planted foot travels backwards in its own in-place walk and
## run (Casual_Walk_inplace, run_fast_3_inplace), at speed_scale 1, in metres a second - the
## numbers Pedestrian needs to set a clip's rate so the foot on the ground stays where it is. The
## gait library's clips carry this as meta (tools/crowd/gait_clips.gd); the rig's own clips used
## one constant for every rig (WALK_CLIP_SPEED 0.8, RUN_CLIP_SPEED 2.75), and a rig a head
## taller or shorter than the one they were set on slid its feet. Prints a GDScript table
## (CrowdStrideTable) with WRITE=1 writes scripts/npc/crowd_stride_table.gd.
##
##   godot --headless --path . -s tools/crowd_closeup_3/stride_fit.gd   (RIGS=crowd_a,... limits it)
const CLIPS := {"walk": "Casual_Walk_inplace", "run": "run_fast_3_inplace", "jog": "life/jog"}
const FRAMES := 240


func _initialize() -> void:
	var ped_script = load("res://scripts/npc/pedestrian.gd")
	var models: Array = Array(ped_script.MODELS)
	var only := OS.get_environment("RIGS").split(",", false)
	var root := Node3D.new()
	get_root().add_child(root)
	var rows: Array = []
	for path: String in models:
		var rig := path.get_file().get_basename()
		if not only.is_empty() and not rig in only:
			continue
		var packed: PackedScene = load(path)
		var inst: Node3D = packed.instantiate()
		root.add_child(inst)
		await process_frame
		var ap: AnimationPlayer = inst.find_children("*", "AnimationPlayer", true, false)[0]
		ped_script.fix_arm_pose(ap, path)
		load("res://scripts/npc/crowd_life.gd").attach(ap, path)
		var skel: Skeleton3D = inst.find_children("*", "Skeleton3D", true, false)[0]
		var row := {"rig": rig}
		for key: String in CLIPS:
			var clip: String = CLIPS[key]
			if not ap.has_animation(clip):
				continue
			row[key] = _measure(ap, skel, clip)
		rows.append(row)
		print("STRIDE %-9s walk %.3f m/s  run %.3f m/s  jog %.3f m/s" % [rig, float(row.get("walk", 0.0)), float(row.get("run", 0.0)), float(row.get("jog", 0.0))])
		inst.free()
	var lines := PackedStringArray()
	lines.append("class_name CrowdStrideTable")
	lines.append("extends RefCounted")
	lines.append("## Generated by tools/crowd_closeup_3/stride_fit.gd: each crowd rig's planted-foot speed in its")
	lines.append("## own in-place walk, run and the life library's jog (m/s at speed_scale 1). Rerun it after any crowd rig rebuild.")
	lines.append("")
	lines.append("const TABLE := {")
	for r: Dictionary in rows:
		lines.append("\t\"%s\": {\"walk\": %.4f, \"run\": %.4f, \"jog\": %.4f}," % [r["rig"], float(r.get("walk", 0.0)), float(r.get("run", 0.0)), float(r.get("jog", 0.0))])
	lines.append("}")
	var text := "\n".join(lines) + "\n"
	if OS.get_environment("WRITE") == "1":
		var f := FileAccess.open("res://scripts/npc/crowd_stride_table.gd", FileAccess.WRITE)
		f.store_string(text)
		f.close()
		print("STRIDE wrote scripts/npc/crowd_stride_table.gd")
	else:
		print(text)
	quit()


## Ground speed of the planted feet over one loop: the toe bases' backward travel (-Z: the rigs
## face +Z) while within 1.5 cm of their lowest, over the time they are.
func _measure(ap: AnimationPlayer, skel: Skeleton3D, clip: String) -> float:
	var a := ap.get_animation(clip)
	ap.play(clip)
	ap.speed_scale = 0.0
	var bones := [skel.find_bone("LeftToeBase"), skel.find_bone("RightToeBase")]
	var tot := 0.0
	var time := 0.0
	var dt := a.length / float(FRAMES)
	var ys: Array = [[], []]
	var zs: Array = [[], []]
	for f in FRAMES + 1:
		ap.seek(dt * float(f), true)
		for s in 2:
			var g := skel.global_transform * skel.get_bone_global_pose(bones[s])
			ys[s].append(g.origin.y)
			zs[s].append(g.origin.z)
	for s in 2:
		var ymin: float = (ys[s] as Array).min()
		for f in FRAMES:
			if ys[s][f] < ymin + 0.015 and ys[s][f + 1] < ymin + 0.015 and zs[s][f + 1] < zs[s][f]:
				tot += zs[s][f] - zs[s][f + 1]
				time += dt
	return tot / time if time > 0.0 else 0.0
