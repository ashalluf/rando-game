+## A smooth route through control points (a Catmull-Rom spline), resampled to one point every
+## STEP metres along the curve: the deck, the traffic and the bake all assume STEP.
+static func _spline(ctrl: PackedVector2Array) -> PackedVector2Array:
+	var fine := PackedVector2Array()
+	for i in ctrl.size() - 1:
+		var p0 := ctrl[maxi(i - 1, 0)]
+		var p1 := ctrl[i]
+		var p2 := ctrl[i + 1]
+		var p3 := ctrl[mini(i + 2, ctrl.size() - 1)]
+		var n := maxi(4, int(p1.distance_to(p2) / 4.0))
+		for k in n:
+			var t := float(k) / float(n)
+			var t2 := t * t
+			var t3 := t2 * t
+			fine.append(0.5 * ((2.0 * p1) + (p2 - p0) * t + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2
+				+ (3.0 * p1 - p0 - 3.0 * p2 + p3) * t3))
+	fine.append(ctrl[ctrl.size() - 1])
+	var out := PackedVector2Array([fine[0]])
+	var carry := 0.0
+	for i in range(1, fine.size()):
+		var a := fine[i - 1]
+		var seg := a.distance_to(fine[i])
+		while carry + seg >= STEP:
+			a = a.lerp(fine[i], (STEP - carry) / seg)
+			seg = a.distance_to(fine[i])
+			out.append(a)
+			carry = 0.0
+		carry += seg
+	return out
+
