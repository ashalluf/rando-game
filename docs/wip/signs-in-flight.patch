diff --git a/shaders/building.gdshader b/shaders/building.gdshader
index bc37781..2aa856f 100644
--- a/shaders/building.gdshader
+++ b/shaders/building.gdshader
@@ -51,6 +51,38 @@ uniform int roof_style = 0;
 // Building picks these and places the shop signs in the world from the same numbers, so the
 // names line up with the sign bands drawn here.
 uniform vec4 shop_span = vec4(3.0, 3.0, 3.0, 3.0);
+
+// --- Shop names ---
+// Every name in Building.SHOP_NAMES, rasterised once into one texture at load (see the atlas
+// note in building.gd). Painting the name here costs one texture fetch on a band this shader
+// already draws, so a fascia carries its name at ANY distance, in the web build too, without a
+// single extra draw call. The raised letters in front of it only exist within a few dozen
+// metres; past that this is the sign.
+uniform sampler2D sign_atlas : hint_default_transparent, filter_linear_mipmap_anisotropic, repeat_disable;
+// Cells across and down the atlas, and the size of one cell in ems.
+uniform vec2 sign_grid = vec2(1.0, 1.0);
+uniform vec2 sign_cell_em = vec2(7.0, 1.3);
+// Advance width of every name in ems, in Building.SHOP_NAMES order, and how many there are.
+// 0 names turns the painted signs off (which is what an unset atlas gets).
+uniform float sign_adv[48];
+uniform int sign_count = 0;
+// Atlas pixels per em, one em of a name in metres, and the fraction of a shop's wall a name
+// may fill before it is shrunk to fit. All three must match Building's.
+uniform float sign_em_px = 96.0;
+uniform float sign_em = 0.50;
+uniform float sign_room = 0.68;
