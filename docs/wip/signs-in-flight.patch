@@ -406,11 +409,282 @@ const SHOP_NAMES := ["PHARMACY", "NAILS & SPA", "DRY CLEAN", "PHONE FIX", "LIQUO
 	"SUSHI", "TACOS", "COFFEE STOP", "BANK", "DONUT HOLE", "SUB STOP", "PET SHOP", "BARBER",
 	"LAUNDRY", "BOBA", "DENTAL", "TAX PRO", "SMOKE SHOP", "FLOWERS", "RECORDS", "HARDWARE",
 	"BOOKS", "BAKERY", "DELI", "OPTICAL", "SHOE REPAIR", "TATTOO", "THRIFT", "CAMERA"]
-## Cap height of a shop sign, in metres.
-const SIGN_HEIGHT := 0.40
-## How far out from the wall the sign sits, and how far a sign still draws.
-const SIGN_STANDOFF := 0.14
-const SIGN_DRAW_DISTANCE := 75.0
+## Em size of a shop sign, in metres: one em of the name maps to this much wall. The cap height
+## is about 0.72 of it, so 0.50 sets 36 cm letters on a 77 cm board - which is what a real fascia
+## looks like, and 25 % more pixels of name at every distance than the 0.40 it used to be. Much
+## above this and the tail of a Q drops into the board's bottom lip.
+const SIGN_HEIGHT := 0.50
+## How far out from the wall the raised letters sit (letters fixed to a board, not a sign hung
+## off the wall. They are letters fixed to a board, not a sign hung off the building, and the
+## further out they stand the further they slide off the painted name behind them when the wall
+## is seen at an angle.
+const SIGN_STANDOFF := 0.045
+## How far the raised letters still draw. The painted name from the atlas is at full strength
+## well before this, so the letters no longer have to carry the sign at distance - they are the
+## relief on top of it, and past 34 m that relief is not worth a draw call.
+const SIGN_DRAW_DISTANCE := 34.0
+## Distance band (metres) over which the painted name takes over from the raised letters. Two
+## rules set it. It has to reach full strength before SIGN_DRAW_DISTANCE culls the letters, or
+## the name pops; and it has to stay at zero while the letters are close enough to read, because
+## the letters stand 4.5 cm off the wall and the paint is on it, so a shopfront seen down the
+## street at a glancing angle slides one off the other - at 14 m that is a third of a letter, and
+## the name reads doubled. So: letters alone up close, paint alone past 33 m, and a one-metre
+## overlap where the letters are six pixels tall and nothing can be told apart.
+const SIGN_FADE := Vector2(26.0, 33.0)
+
+# --- The shop-name atlas -------------------------------------------------------------------
+# Every name in SHOP_NAMES, rasterised once at load into one texture, which
+# shaders/building.gdshader samples in the sign-band branch it already draws. That paints the
+# right name on every fascia at any distance for no extra draw call, no geometry and no editor
+# step - and it works on the web build, where the raised letters are skipped entirely. Before
+# this, a shop more than 75 m away (or any shop at all in a browser) had a blank painted board,
+# which is one of the loudest "this is a game level" tells a commercial strip can have.
+## Pixels per em the names are rasterised at. The letters are magnified past about 1.2 m, so
+## this is what decides how crisp a sign is with your nose against it.
+const SIGN_ATLAS_EM := 96
+## Clear pixels kept around each cell, so a mip level does not bleed one name into the next.
+const SIGN_ATLAS_PAD := 7
+## Cells across the atlas.
+const SIGN_ATLAS_COLS := 4
+## Length of the shader's `sign_adv` uniform array: the most names the atlas can hold.
+const SIGN_ADV_SLOTS := 48
+## Extra letter spacing mixed across the names, so a strip is not all one setting. In whole
+## pixels at the TextMesh's own font size (48), because that is the only spacing a FontVariation
+## can be given - a fraction of a pixel there and the raised letters stop matching the painted
+## name behind them.
+const SIGN_TRACKING_PX := [1, 2, 3, 4]
+## Fraction of a shop's wall a name may fill before it is shrunk. Shared with the shader. It has
+## to leave room for the piers that stand at both ends of every shop run: at 0.80 a long name ran
+## its first and last letter straight into one, which reads as a clipped sign rather than a long
+## one. A half-metre pier on a five-metre run is a tenth of it, so a name stops well short.
+const SIGN_ROOM := 0.68
+## Font size the raised letters are generated at (PropFactory.text_mesh uses the same).
+const SIGN_FONT_SIZE := 48
+
+static var _sign_atlas: ImageTexture = null
+## Letter meshes, letter materials and the tracked font variations, shared across the city.
+static var _sign_cache := {}
+## Advance width of each name in ems, measured from the real glyphs. The shader shrinks a name
+## that will not fit its run from this, exactly the way the raised letters are shrunk, so the
+## two are the same size and the crossfade has nothing to show.
+static var _sign_adv := PackedFloat32Array()
+## Size of one atlas cell in ems, and the cell grid.
+static var _sign_cell_em := Vector2.ZERO
+static var _sign_grid := Vector2i.ZERO
+
+
+## The shop-name atlas, built on first use. Null only if the text server has no font at all.
+static func sign_atlas() -> ImageTexture:
+	if _sign_atlas == null:
+		_build_sign_atlas()
+	return _sign_atlas
+
+
+## 32-bit multiply without overflowing GDScript's 64-bit int, so the name hash below is exactly
+## the `uint` arithmetic the shader does. Floats cannot be trusted here: the shader works in
+## 32-bit and this in 64-bit, and a name index that disagrees by one puts a different word on
+## the board than the raised letters spell.
+static func _mul32(a: int, b: int) -> int:
+	return ((a & 0xFFFF) * b + ((((a >> 16) & 0xFFFF) * b) << 16)) & 0xFFFFFFFF
+
+
+static func _sign_hash(a: int, b: int, c: int) -> int:
+	var h := (_mul32(a, 374761393) + _mul32(b, 668265263) + _mul32(c, 2246822519)) & 0xFFFFFFFF
+	h = (h ^ (h >> 13)) & 0xFFFFFFFF
+	h = _mul32(h, 1274126177)
+	return (h ^ (h >> 16)) & 0xFFFFFFFF
+
+
+## How many names the atlas holds: the list, capped at the shader's array length.
+static func sign_name_count() -> int:
+	return mini(SHOP_NAMES.size(), SIGN_ADV_SLOTS)
+
+
+## Which name shop `run` on `face_id` gets. The shader runs the identical hash, so the painted
+## name and the raised letters always spell the same thing.
+static func sign_name_index(run: int, face_id: int, seed_value: int) -> int:
+	var n := sign_name_count()
+	var s := seed_value & 0xFFFF
+	var i := _sign_hash(run & 0xFFFF, face_id, s) % n
+	if run > 0 and i == _sign_hash((run - 1) & 0xFFFF, face_id, s) % n:
+		# Two of the same shop side by side reads as a bug even though real streets do it.
+		i = (i + 1) % n
+	return i
+
+
+## 0..99 for one shop, the roll the shader paints its board colour from (and whether the sign is
+## lit after dark). The letters in front of the board have to know both: dark letters on a cream
+## board, light ones on the rest, and no glow on a shop that leaves its sign off.
+static func sign_board_pick(run: int, face_id: int, seed_value: int) -> int:
+	return _sign_hash(run & 0xFFFF, face_id + 18, (seed_value & 0xFFFF) + 911) % 100
+
+
+## Advance width of one name in ems, measured from the glyphs the atlas was built from.
+static func sign_advance(name_i: int) -> float:
+	if _sign_adv.is_empty():
+		_build_sign_atlas()
+	if name_i < 0 or name_i >= _sign_adv.size():
+		return 4.0
+	return _sign_adv[name_i]
+
+
+## Hands the atlas and its layout to one facade material. Without it the shader's `sign_count`
+## stays 0 and every board is painted blank, which is what they all used to be.
+static func apply_sign_atlas(mat: ShaderMaterial) -> void:
+	var tex := sign_atlas()
+	if tex == null:
+		return
+	mat.set_shader_parameter("sign_atlas", tex)
+	mat.set_shader_parameter("sign_grid", Vector2(_sign_grid))
+	mat.set_shader_parameter("sign_cell_em", _sign_cell_em)
+	mat.set_shader_parameter("sign_adv", _sign_adv)
+	mat.set_shader_parameter("sign_count", sign_name_count())
+	mat.set_shader_parameter("sign_em_px", float(SIGN_ATLAS_EM))
+	mat.set_shader_parameter("sign_em", SIGN_HEIGHT)
+	mat.set_shader_parameter("sign_room", SIGN_ROOM)
+	mat.set_shader_parameter("sign_fade", SIGN_FADE)
+	# The web build has no raised letters at all, so there the paint has to carry the near view
+	# as well; on desktop it fades in as the letters go.
+	mat.set_shader_parameter("sign_paint_near", 1.0 if OS.has_feature("web") else 0.0)
+
+
+## The font the raised letters are set in, with the same tracking the atlas used for this name.
+static func _sign_font(track_px: int) -> Font:
+	var key := "signfont%d" % track_px
+	if _sign_cache.has(key):
+		return _sign_cache[key]
+	var fv := FontVariation.new()
+	fv.base_font = ThemeDB.fallback_font
+	fv.set_spacing(TextServer.SPACING_GLYPH, track_px)
+	_sign_cache[key] = fv
+	return fv
+
+
+## The raised letters of one name: real extruded text, standing just off the board, which is
+## what gives a shopfront relief close up. Cached per name - a street reuses a handful.
+static func sign_letter_mesh(name_i: int) -> Mesh:
+	var key := "signmesh%d" % name_i
+	if _sign_cache.has(key):
+		return _sign_cache[key]
+	var tm := TextMesh.new()
+	tm.text = SHOP_NAMES[name_i]
+	tm.font = _sign_font(SIGN_TRACKING_PX[name_i % SIGN_TRACKING_PX.size()])
+	tm.font_size = SIGN_FONT_SIZE
+	tm.pixel_size = SIGN_HEIGHT / float(SIGN_FONT_SIZE)
+	tm.depth = 0.012
+	tm.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	tm.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	_sign_cache[key] = tm
+	return tm
+
+
+## Material for the raised letters. It reads `lamp_factor` like the painted name behind it does,
+## so the letters light up with the street lamps and are matte by day - and nothing changes
+## brightness when they cull out and the paint alone carries the sign.
+static func sign_letter_material(light_ink: bool, lit: bool) -> ShaderMaterial:
+	var key := "signmat%s%s" % [light_ink, lit]
+	if _sign_cache.has(key):
+		return _sign_cache[key]
+	var mat := ShaderMaterial.new()
+	mat.shader = LETTER_SHADER
+	mat.set_shader_parameter("ink", Color(0.94, 0.92, 0.87) if light_ink else Color(0.06, 0.06, 0.07))
+	mat.set_shader_parameter("glow", 1.15 if lit else 0.0)
+	_sign_cache[key] = mat
+	return mat
+
+
+static func _build_sign_atlas() -> void:
+	var ts := TextServerManager.get_primary_interface()
+	var font: Font = ThemeDB.fallback_font
+	if ts == null or font == null or font.get_rids().is_empty():
+		# No font at all: leave the atlas null (the shader then paints blank boards) but fill
+		# the widths, or every raised letter asks for the atlas again and rebuilds nothing.
+		_sign_adv.resize(SIGN_ADV_SLOTS)
+		_sign_adv.fill(4.0)
+		return
+	var rids := font.get_rids()
+	var em := float(SIGN_ATLAS_EM)
+	var size_i := Vector2i(SIGN_ATLAS_EM, 0)
+	# Shape every name once and keep where each glyph lands, so the cell layout below and the
+	# blit afterwards cannot disagree.
+	var shaped: Array = []
+	var ink_top := 1e9
+	var ink_bottom := -1e9
+	var max_w := 0.0
+	# One slot per name, padded out to the array the shader declares (48), because a uniform
+	# array has to be handed exactly as many values as it was declared with.
+	_sign_adv.resize(SIGN_ADV_SLOTS)
+	_sign_adv.fill(4.0)
+	for n in sign_name_count():
+		var line := ts.create_shaped_text()
+		ts.shaped_text_add_string(line, SHOP_NAMES[n], rids, SIGN_ATLAS_EM)
+		ts.shaped_text_shape(line)
+		# The same tracking the raised letters are set with, in atlas pixels. It is added after
+		# the last glyph as well, because that is what a FontVariation's glyph spacing does, and
+		# the two have to centre on the same width.
+		var track := float(SIGN_TRACKING_PX[n % SIGN_TRACKING_PX.size()]) * em / float(SIGN_FONT_SIZE)
+		var pen := 0.0
+		var placed: Array = []
+		for g in ts.shaped_text_get_glyphs(line):
+			var frid: RID = g.font_rid
+			var gi: int = g.index
+			if frid.is_valid() and gi != 0:
+				ts.font_render_glyph(frid, size_i, gi)
+				var gsz: Vector2 = ts.font_get_glyph_size(frid, size_i, gi)
+				var off: Vector2 = ts.font_get_glyph_offset(frid, size_i, gi)
+				if gsz.x > 0.5 and gsz.y > 0.5:
+					placed.append([frid, gi, pen + g.offset.x + off.x, g.offset.y + off.y])
+					ink_top = minf(ink_top, g.offset.y + off.y)
+					ink_bottom = maxf(ink_bottom, g.offset.y + off.y + gsz.y)
+			pen += g.advance + track
+		pen = maxf(pen, 1.0)
+		shaped.append([placed, pen])
+		_sign_adv[n] = pen / em
+		max_w = maxf(max_w, pen)
+		ts.free_rid(line)
+	if ink_bottom < ink_top:
+		return
+	# A cell's vertical centre is the line box centre, which is where a TextMesh with
+	# VERTICAL_ALIGNMENT_CENTER puts its text, so the painted name sits on exactly the same line
+	# as the raised letters in front of it.
+	var pad := float(SIGN_ATLAS_PAD)
+	var mid := (font.get_ascent(SIGN_ATLAS_EM) - font.get_descent(SIGN_ATLAS_EM)) * 0.5
+	var half := maxf(absf(ink_top + mid), absf(ink_bottom + mid)) + pad
+	var cell_h := int(ceil(half * 2.0))
+	var cell_w := int(ceil(max_w + pad * 2.0))
+	var cols := SIGN_ATLAS_COLS
+	var rows := int(ceil(float(sign_name_count()) / float(cols)))
+	var base_y := float(cell_h) * 0.5 + mid
+	var img := Image.create(cols * cell_w, rows * cell_h, false, Image.FORMAT_LA8)
+	img.fill(Color(1.0, 1.0, 1.0, 0.0))
+	# The glyph cache's own textures, fetched only now: every glyph has been rendered into them
+	# by the loop above, and fetching one before that can hand back a page without the glyph.
+	var pages := {}
+	for n in shaped.size():
+		var placed: Array = shaped[n][0]
+		var width: float = shaped[n][1]
+		var ox := float((n % cols) * cell_w) + (float(cell_w) - width) * 0.5
+		var oy := float(n / cols) * float(cell_h) + base_y
+		for p: Array in placed:
+			var frid: RID = p[0]
+			var gi: int = p[1]
+			var tidx := ts.font_get_glyph_texture_idx(frid, size_i, gi)
+			if tidx < 0:
+				continue
+			var key := "%d:%d" % [frid.get_id(), tidx]
+			if not pages.has(key):
+				var page: Image = ts.font_get_texture_image(frid, size_i, tidx)
+				if page == null:
+					continue
+				if page.get_format() != Image.FORMAT_LA8:
+					page.convert(Image.FORMAT_LA8)
+				pages[key] = page
+			var uv: Rect2 = ts.font_get_glyph_uv_rect(frid, size_i, gi)
+			img.blend_rect(pages[key], Rect2i(uv), Vector2i(roundi(ox + p[2]), roundi(oy + p[3])))
+	img.generate_mipmaps()
+	_sign_atlas = ImageTexture.create_from_image(img)
+	_sign_cell_em = Vector2(float(cell_w) / em, float(cell_h) / em)
+	_sign_grid = Vector2i(cols, rows)
 
 
 ## How many bays make one shop on each face, matching shaders/building.gdshader's `shop_span`.
